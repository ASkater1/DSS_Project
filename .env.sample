# The name of the database container/ the domain under which the database is reachable.
DB_HOST=database
# The name of the database containing our "data warehouse".
DB_NAME=dss
# The username to connect to the database.
DB_USER=dss
# The secret password to connect to the database.
DB_PASSWORD=dsspassword
# How many rows the static importer should read from the CSV file at once. This is used to avoid memory issues when reading large files.
STATIC_IMPORTER_CHUNKSIZE_INTERNAL=5000
# How many rows the static importer should insert into the database at once. This is used to avoid memory issues when inserting large files.
STATIC_IMPORTER_INSERTING_CHUNKSIZE=500